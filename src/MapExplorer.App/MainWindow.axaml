<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:MapExplorer.App.Views"
        xmlns:vm="using:MapExplorer.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        Width="1100" Height="750"
        x:Class="MapExplorer.App.MainWindow"
        x:DataType="vm:MapViewModel"
        Title="Minecraft Map Explorer"
        Background="#111111">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1a1a2e" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="LoadButton" Content="Load World" Click="OnLoadClicked" />
                <TextBlock VerticalAlignment="Center" Foreground="#CCCCCC" Text="{Binding StatusText}" />
            </StackPanel>
        </Border>
        <views:LayerPanelView DockPanel.Dock="Right" DataContext="{Binding}" />
        <views:MapCanvasControl x:Name="MapCanvas" />
    </DockPanel>
</Window>
