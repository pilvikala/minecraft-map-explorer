<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:MapExplorer.App.Views"
        xmlns:vm="using:MapExplorer.App.ViewModels"
        xmlns:local="using:MapExplorer.App"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        Width="1100" Height="750"
        x:Class="MapExplorer.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Minecraft Map Explorer"
        Icon="/Assets/icon.ico"
        Background="#111111">
    <Grid>
        <ContentControl IsVisible="{Binding ShowPicker}" Content="{Binding WorldPicker}">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:WorldPickerViewModel">
                    <views:WorldPickerView DataContext="{Binding}" />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <TextBlock Text="{x:Static local:AppVersionInfo.Version}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,2"
                   FontSize="10" Foreground="#666666" ZIndex="1" />

        <DockPanel IsVisible="{Binding ShowMap}">
            <Border DockPanel.Dock="Top" Background="#1a1a2e" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Minecraft Map Explorer" FontWeight="Bold" Foreground="#8bc34a" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Foreground="#CCCCCC" Text="{Binding Map.StatusText}" />
                    <Button Content="Overworld" Click="OnDimensionClicked" Tag="{x:Static vm:Dimension.Overworld}"
                            Classes.active="{Binding IsOverworldActive}" Classes="dimBtn" Margin="24,0,0,0" />
                    <Button Content="Nether" Click="OnDimensionClicked" Tag="{x:Static vm:Dimension.Nether}"
                            Classes.active="{Binding IsNetherActive}" Classes="dimBtn"
                            IsEnabled="{Binding IsNetherAvailable}" ToolTip.Tip="{Binding NetherTooltip}" />
                    <Button Content="End" Click="OnDimensionClicked" Tag="{x:Static vm:Dimension.End}"
                            Classes.active="{Binding IsEndActive}" Classes="dimBtn"
                            IsEnabled="{Binding IsEndAvailable}" ToolTip.Tip="{Binding EndTooltip}" />
                    <Button Content="Players" Click="OnPlayersClicked"
                            Classes.active="{Binding IsPlayersPanelOpen}" Classes="dimBtn" Margin="24,0,0,0" />
                    <Button Content="Edit" Click="OnEditClicked"
                            Classes.active="{Binding Edit.IsEditModeOn}" Classes="dimBtn" />
                    <Button Content="← Worlds" Click="OnBackClicked" Margin="24,0,0,0"
                            Background="Transparent" Foreground="#aaaaaa" BorderBrush="#444444" BorderThickness="1" />
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Left" IsVisible="{Binding IsPlayersPanelOpen}">
                <views:PlayersView DataContext="{Binding Players}" />
            </Border>
            <Border DockPanel.Dock="Left" IsVisible="{Binding Edit.IsEditModeOn}">
                <views:EditPanelView DataContext="{Binding Edit}" />
            </Border>
            <views:LayerPanelView DockPanel.Dock="Right" DataContext="{Binding Map}" />
            <Grid>
                <views:MapCanvasControl x:Name="MapCanvas" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                        Background="#cc1a1a2e" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="6,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="−" Width="26" Height="26" Classes="zoomBtn" Click="OnZoomOutClicked" />
                        <TextBlock x:Name="ZoomLevelText" Text="100%" VerticalAlignment="Center" Foreground="#cccccc" MinWidth="46" TextAlignment="Center" />
                        <Button Content="+" Width="26" Height="26" Classes="zoomBtn" Click="OnZoomInClicked" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>

    <Window.Styles>
        <!-- Mirrors LayerPanelView's modeBtn/active styling for visual consistency
             between the view-mode buttons and these dimension tabs. -->
        <Style Selector="Button.dimBtn">
            <Setter Property="Background" Value="#2a2a3a" />
            <Setter Property="Foreground" Value="#cccccc" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="Button.dimBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3f3f52" />
        </Style>
        <Style Selector="Button.dimBtn.active">
            <Setter Property="Background" Value="#3a7d44" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3a7d44" />
        </Style>
        <Style Selector="Button.dimBtn.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#458f4f" />
        </Style>
        <Style Selector="Button.dimBtn:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Button.zoomBtn">
            <Setter Property="Background" Value="#2a2a3a" />
            <Setter Property="Foreground" Value="#dddddd" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.zoomBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3f3f52" />
        </Style>
    </Window.Styles>
</Window>
